<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- UWP targeting: this is what Xbox runs -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Required for [ObservableProperty] on partial properties
         (MVVM Toolkit source generator, see MVVMTK0041). -->
    <LangVersion>preview</LangVersion>
    <!-- Bundle the .NET 9 UWP runtime inside the MSIX. Without this the
         package is framework-dependent: it installs but cannot start on
         machines that don't have the .NET UWP runtime (it is NOT inbox
         on Windows), so the app dies right after the splash screen.
         JIT (not PublishAot): DI and System.Text.Json reflection need
         the full runtime. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Modern .NET UWP: activates the VS UWP XAML toolchain (XAML compiler,
         Windows.UI.Xaml projection via CsWinRT, appx packaging). VS 18 /
         .NET 9 SDK set UseUwpTools from this automatically. -->
    <UseUwp>true</UseUwp>
    <!-- Activates the MSIX/UWP packaging targets for command-line builds
         (VS normally sets this in the .user file). -->
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

    <ItemGroup>
    <!-- WinUI 2 (Microsoft.UI.Xaml) only ships uap10.0 assets, which NuGet
         won't select for the net9.0-windows10.0.26100.0 TFM used by the
         Modern .NET UWP toolchain - the app uses stock UWP controls. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JellyfinClient\JellyfinClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\**" />
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="Properties\Default.rd.xml" />
  </ItemGroup>

</Project>
