<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- UWP targeting: this is what Xbox runs -->
    <OutputType>AppContainerExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Modern .NET UWP: activates the VS UWP XAML toolchain (XAML compiler,
         Windows.UI.Xaml projection via CsWinRT, appx packaging). VS 18 /
         .NET 9 SDK set UseUwpTools from this automatically. -->
    <UseUwp>true</UseUwp>
    <!-- Activates the MSIX/UWP packaging targets for command-line builds
         (VS normally sets this in the .user file). -->
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinUI 2: provides Microsoft.UI.Xaml.Controls (Page, Frame, etc.) for UWP -->
    <PackageReference Include="Microsoft.UI.Xaml" Version="2.8.6" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JellyfinClient\JellyfinClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\**" />
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
