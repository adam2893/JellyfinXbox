<Page
    x:Class="JellyfinXbox.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:JellyfinClient.Models">

    <Grid Background="Black">
        <!-- ═══════════════════════════════════════ -->
        <!--         MEDIA RENDERER                  -->
        <!-- ═══════════════════════════════════════ -->
        <MediaPlayerElement x:Name="PlayerElement"
                            AutoPlay="True" />

        <!-- ═══════════════════════════════════════ -->
        <!--          LOADING OVERLAY                -->
        <!-- ═══════════════════════════════════════ -->
        <Grid x:Name="LoadingOverlay"
              Visibility="{x:Bind ViewModel.IsBuffering, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#99000000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="48" Height="48"
                              Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Buffering..." FontSize="16"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border Visibility="{x:Bind ViewModel.HasPlaybackError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Background="#F00B1020" Padding="28" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
            <StackPanel Spacing="14">
                <TextBlock Text="Playback unavailable" FontSize="22" FontWeight="SemiBold" Foreground="White" />
                <TextBlock Text="{x:Bind ViewModel.PlaybackErrorMessage, Mode=OneWay}" TextWrapping="Wrap" Foreground="White" />
                <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Retry" Command="{x:Bind ViewModel.RetryPlaybackCommand}" /><Button Content="Back" Command="{x:Bind ViewModel.StopCommand}" /></StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════ -->
        <!--        INTRO & CREDITS SKIPPER          -->
        <!-- ═══════════════════════════════════════ -->
        <Button x:Name="SkipPromptButton"
                Command="{x:Bind ViewModel.SkipIntroCommand}"
                Visibility="{x:Bind ViewModel.ShowSkipPrompt, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Margin="0 0 60 170"
                Padding="22 14" CornerRadius="10"
                Background="#E61E293B" BorderBrush="#80FFFFFF" BorderThickness="1.5">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE893;" FontSize="18" Foreground="White" />
                <TextBlock Text="{x:Bind ViewModel.SkipPromptText, Mode=OneWay}"
                           FontSize="16" FontWeight="SemiBold" Foreground="White" />
                <Border Background="#40FFFFFF" CornerRadius="4" Padding="6 2" Margin="6 0 0 0">
                    <TextBlock Text="Y" FontSize="12" FontWeight="Bold" Foreground="#60A5FA" />
                </Border>
            </StackPanel>
        </Button>

        <!-- ═══════════════════════════════════════ -->
        <!--           UP NEXT OVERLAY               -->
        <!-- ═══════════════════════════════════════ -->
        <Border Visibility="{x:Bind ViewModel.ShowUpNextOverlay, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Margin="0 0 60 170" Width="380"
                Background="#F00F172A" BorderBrush="#50FFFFFF" BorderThickness="1.5"
                CornerRadius="14" Padding="20">
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock Text="UP NEXT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" CharacterSpacing="100" />
                    <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.CancelUpNextCommand}"
                            Background="Transparent" Padding="4" Margin="0 -4 -4 0">
                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="#FFFFFFAA" />
                    </Button>
                </Grid>
                <Grid Margin="0 4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="90" Height="50" CornerRadius="6"
                            Background="#20FFFFFF" Margin="0 0 12 0"
                            Visibility="{x:Bind ViewModel.UpNextThumbnailUrl, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                        <Image Source="{x:Bind ViewModel.UpNextThumbnailUrl, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.UpNextTitle, Mode=OneWay}"
                               FontSize="15" FontWeight="SemiBold" Foreground="White"
                               TextTrimming="CharacterEllipsis" MaxLines="2" VerticalAlignment="Center" />
                </Grid>
                <Button Command="{x:Bind ViewModel.PlayNextCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="16 10" CornerRadius="8"
                        HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="{x:Bind ViewModel.UpNextCountdownText, Mode=OneWay}"
                                   FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════ -->
        <!--         TRICKPLAY SCRUB PREVIEW         -->
        <!-- ═══════════════════════════════════════ -->
        <Border Visibility="{x:Bind ViewModel.ShowTrickplayPreview, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0 0 0 150"
                Background="#F00A0F1D" BorderBrush="#50FFFFFF" BorderThickness="1.5"
                CornerRadius="10" Padding="8">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <Border Width="240" Height="135" CornerRadius="6" Background="#20FFFFFF">
                    <Image Source="{x:Bind ViewModel.TrickplayPreviewUrl, Mode=OneWay}"
                           Stretch="UniformToFill" />
                </Border>
                <TextBlock Text="{x:Bind ViewModel.TrickplayTimeText, Mode=OneWay}"
                           FontSize="14" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════ -->
        <!--     ENHANCED TRACK & SETTINGS DRAWER    -->
        <!-- ═══════════════════════════════════════ -->
        <Grid x:Name="TrackPanel"
              Visibility="{x:Bind ViewModel.TrackSelection.IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
              HorizontalAlignment="Right" VerticalAlignment="Stretch"
              Width="480" Padding="0">
            <Grid.Background>
                <SolidColorBrush Color="#FA0F172A" />
            </Grid.Background>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" Padding="28">
                <StackPanel Spacing="24">
                    <!-- Drawer Header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Playback Settings" FontSize="22" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Click="CloseTrackPanel_Click"
                                Background="Transparent" Foreground="White"
                                Padding="8" CornerRadius="6">
                            <FontIcon Glyph="&#xE711;" FontSize="16" />
                        </Button>
                    </Grid>

                    <!-- ═══ Playback Speed ═══ -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="Playback Speed" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFFCC" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="0.5×" Click="Speed_Click" Tag="0.5" Padding="12 8" CornerRadius="6" Background="#33FFFFFF" Foreground="White" />
                            <Button Content="0.75×" Click="Speed_Click" Tag="0.75" Padding="12 8" CornerRadius="6" Background="#33FFFFFF" Foreground="White" />
                            <Button Content="1.0×" Click="Speed_Click" Tag="1.0" Padding="12 8" CornerRadius="6" Background="{StaticResource AccentBrush}" Foreground="White" />
                            <Button Content="1.25×" Click="Speed_Click" Tag="1.25" Padding="12 8" CornerRadius="6" Background="#33FFFFFF" Foreground="White" />
                            <Button Content="1.5×" Click="Speed_Click" Tag="1.5" Padding="12 8" CornerRadius="6" Background="#33FFFFFF" Foreground="White" />
                            <Button Content="2.0×" Click="Speed_Click" Tag="2.0" Padding="12 8" CornerRadius="6" Background="#33FFFFFF" Foreground="White" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ═══ Audio & Subtitle Sync Delay ═══ -->
                    <StackPanel Spacing="12">
                        <TextBlock Text="Sync Offsets" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFFCC" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Audio Offset -->
                            <StackPanel Grid.Column="0" Spacing="6" Background="#1AFFFFFF" Padding="12" CornerRadius="8">
                                <TextBlock Text="Audio Delay" FontSize="13" Foreground="#FFFFFFAA" />
                                <TextBlock Text="{x:Bind ViewModel.AudioOffsetDisplay, Mode=OneWay}"
                                           FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0 4" />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Button Content="–100ms" Click="AudioDelayMinus_Click" Padding="8 4" FontSize="12" Background="#33FFFFFF" Foreground="White" CornerRadius="4" />
                                    <Button Content="+100ms" Click="AudioDelayPlus_Click" Padding="8 4" FontSize="12" Background="#33FFFFFF" Foreground="White" CornerRadius="4" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Subtitle Offset -->
                            <StackPanel Grid.Column="1" Spacing="6" Background="#1AFFFFFF" Padding="12" CornerRadius="8">
                                <TextBlock Text="Subtitle Delay" FontSize="13" Foreground="#FFFFFFAA" />
                                <TextBlock Text="{x:Bind ViewModel.SubtitleOffsetDisplay, Mode=OneWay}"
                                           FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0 4" />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Button Content="–100ms" Click="SubDelayMinus_Click" Padding="8 4" FontSize="12" Background="#33FFFFFF" Foreground="White" CornerRadius="4" />
                                    <Button Content="+100ms" Click="SubDelayPlus_Click" Padding="8 4" FontSize="12" Background="#33FFFFFF" Foreground="White" CornerRadius="4" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- ═══ Audio Tracks ═══ -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="Audio Tracks" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFFCC" />
                        <ListView x:Name="AudioListView"
                                  ItemsSource="{x:Bind ViewModel.TrackSelection.AudioTracks}"
                                  SelectionMode="Single"
                                  SelectionChanged="AudioListView_SelectionChanged"
                                  Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="8 10" Spacing="2">
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   FontSize="14" FontWeight="Medium" Foreground="White" />
                                        <TextBlock Text="{Binding Codec}"
                                                   FontSize="12" Foreground="#FFFFFF88" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- ═══ Subtitle Tracks & Online Search ═══ -->
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="Subtitle Tracks" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFFCC" VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right" Click="SearchOnlineSubtitles_Click"
                                    Background="#33FFFFFF" Foreground="White" Padding="10 4" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE721;" FontSize="12" />
                                    <TextBlock Text="Search Online" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ListView x:Name="SubtitleListView"
                                  ItemsSource="{x:Bind ViewModel.TrackSelection.SubtitleTracks}"
                                  SelectionMode="Single"
                                  SelectionChanged="SubtitleListView_SelectionChanged"
                                  Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="8 10" Spacing="2">
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   FontSize="14" FontWeight="Medium" Foreground="White" />
                                        <TextBlock Text="{Binding Codec}"
                                                   FontSize="12" Foreground="#FFFFFF88" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Online Subtitle Search Results (OpenSubtitles Plugin) -->
                        <StackPanel Visibility="{x:Bind ViewModel.TrackSelection.RemoteSubtitles.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}"
                                    Spacing="8" Background="#15FFFFFF" Padding="12" CornerRadius="8">
                            <TextBlock Text="Online Results (OpenSubtitles)" FontSize="13" FontWeight="SemiBold" Foreground="#60A5FA" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.TrackSelection.RemoteSubtitles, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0 4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ProviderName}" FontSize="11" Foreground="#FFFFFF88" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Click="DownloadSubtitle_Click"
                                                    Style="{StaticResource AccentButtonStyle}" Padding="10 6" CornerRadius="6">
                                                <FontIcon Glyph="&#xE896;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- ═══ Chapters List ═══ -->
                    <StackPanel Visibility="{x:Bind ViewModel.Chapters.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}" Spacing="10">
                        <TextBlock Text="Chapters" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFFCC" />
                        <ListView ItemsSource="{x:Bind ViewModel.Chapters, Mode=OneWay}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="Chapter_ItemClick"
                                  Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8 10">
                                        <TextBlock Text="{Binding Name}" FontSize="14" Foreground="White" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══════════════════════════════════════ -->
        <!--          TRANSPORT CONTROLS             -->
        <!-- ═══════════════════════════════════════ -->
        <Grid x:Name="TransportOverlay"
              VerticalAlignment="Bottom"
              Padding="60 24">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Transparent" Offset="0.0" />
                    <GradientStop Color="#99000000" Offset="0.5" />
                    <GradientStop Color="#E6000000" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel Spacing="16">
                <!-- Title & Chapter -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="White" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                                   FontSize="14" Foreground="#FFFFFFAA"
                                   Visibility="{x:Bind ViewModel.Subtitle, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />
                        <TextBlock Text="{x:Bind ViewModel.CurrentChapterName, Mode=OneWay}"
                                   FontSize="14" FontWeight="Medium" Foreground="#60A5FA"
                                   Visibility="{x:Bind ViewModel.CurrentChapterName, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>

                <!-- Seek bar -->
                <Slider x:Name="SeekSlider"
                        MinWidth="600"
                        Value="{x:Bind ViewModel.SliderSeconds, Mode=TwoWay}"
                        Maximum="{x:Bind ViewModel.Duration.TotalSeconds, Mode=OneWay}"
                        ThumbToolTipValueConverter="{StaticResource TimeSpanConverter}"
                        Foreground="{StaticResource AccentBrush}"
                        PointerPressed="SeekSlider_PointerPressed"
                        PointerReleased="SeekSlider_PointerReleased"
                        PointerCaptureLost="SeekSlider_PointerCaptureLost" />

                <!-- Time + controls + info -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{x:Bind ViewModel.PositionDisplay, Mode=OneWay}"
                               FontSize="13" Foreground="#FFFFFFCC"
                               VerticalAlignment="Center" />

                    <!-- Transport buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" Spacing="8">
                        <!-- Prev Chapter -->
                        <Button Command="{x:Bind ViewModel.PreviousChapterCommand}" Background="Transparent"
                                Foreground="White" Padding="12" CornerRadius="8"
                                ToolTipService.ToolTip="Previous Chapter">
                            <FontIcon Glyph="&#xE892;" FontSize="18" />
                        </Button>
                        <Button Click="SeekBack_Click" Background="Transparent"
                                Foreground="White" Padding="12" CornerRadius="8"
                                ToolTipService.ToolTip="Rewind 10s">
                            <FontIcon Glyph="&#xE71F;" FontSize="20" />
                        </Button>
                        <Button Click="PlayPause_Click" Background="Transparent"
                                Foreground="White" Padding="16" CornerRadius="8">
                            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="32" />
                        </Button>
                        <Button Click="SeekForward_Click" Background="Transparent"
                                Foreground="White" Padding="12" CornerRadius="8"
                                ToolTipService.ToolTip="Forward 10s">
                            <FontIcon Glyph="&#xE720;" FontSize="20" />
                        </Button>
                        <!-- Next Chapter -->
                        <Button Command="{x:Bind ViewModel.NextChapterCommand}" Background="Transparent"
                                Foreground="White" Padding="12" CornerRadius="8"
                                ToolTipService.ToolTip="Next Chapter">
                            <FontIcon Glyph="&#xE893;" FontSize="18" />
                        </Button>

                        <!-- Speed toggle button -->
                        <Button Command="{x:Bind ViewModel.CyclePlaybackSpeedCommand}" Background="#33FFFFFF"
                                Foreground="White" Padding="12 6" CornerRadius="6" Margin="8 0 0 0"
                                ToolTipService.ToolTip="Playback Speed">
                            <TextBlock Text="{x:Bind ViewModel.PlaybackSpeedDisplay, Mode=OneWay}" FontSize="13" FontWeight="Bold" />
                        </Button>

                        <!-- Settings & Track panel toggle -->
                        <Border Width="1" Background="#40FFFFFF" Margin="8 4" />

                        <Button Click="ToggleTrackPanel_Click" Background="Transparent"
                                Foreground="White" Padding="12" CornerRadius="8"
                                ToolTipService.ToolTip="Audio, Subtitles &amp; Settings">
                            <FontIcon Glyph="&#xEDC4;" FontSize="20" />
                        </Button>
                    </StackPanel>

                    <!-- Codec info badges -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                Spacing="12" VerticalAlignment="Center">
                        <Border Padding="8 4" CornerRadius="6" Background="#40FFFFFF"
                                Visibility="{x:Bind ViewModel.IsDirectPlay, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Direct Play" FontSize="11"
                                       Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                        </Border>
                        <Border Padding="8 4" CornerRadius="6" Background="#40FFFFFF"
                                Visibility="{x:Bind ViewModel.IsHdr, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="HDR" FontSize="11"
                                       Foreground="#F472B6" FontWeight="SemiBold" />
                        </Border>
                        <Border Padding="8 4" CornerRadius="6" Background="#40FFFFFF">
                            <TextBlock Text="{x:Bind ViewModel.CurrentVideoCodec, Mode=OneWay}"
                                       FontSize="11" Foreground="White" FontWeight="Medium" />
                        </Border>
                        <Border Padding="8 4" CornerRadius="6" Background="#40FFFFFF">
                            <TextBlock Text="{x:Bind ViewModel.CurrentAudioCodec, Mode=OneWay}"
                                       FontSize="11" Foreground="White" FontWeight="Medium" />
                        </Border>
                        <Border Padding="8 4" CornerRadius="6" Background="#40FFFFFF"
                                Visibility="{x:Bind ViewModel.CurrentResolution, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{x:Bind ViewModel.CurrentResolution, Mode=OneWay}"
                                       FontSize="11" Foreground="White" />
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════ -->
        <!--           TOP INFO BAR                  -->
        <!-- ═══════════════════════════════════════ -->
        <Grid VerticalAlignment="Top" Padding="60 24">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E6000000" Offset="0.0" />
                    <GradientStop Color="#99000000" Offset="0.5" />
                    <GradientStop Color="Transparent" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Click="Back_Click" Background="Transparent"
                    Foreground="White" Padding="12" CornerRadius="8">
                <FontIcon Glyph="&#xE72B;" FontSize="20" />
            </Button>
        </Grid>
    </Grid>
</Page>
