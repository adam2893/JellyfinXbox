<Page
    x:Class="JellyfinXbox.Views.MediaDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Background="{StaticResource SurfacePrimaryBrush}">
        <!-- Full-bleed cinematic backdrop. The shell hides its rail on this
             page, so the artwork owns the entire Xbox viewport. -->
        <Image x:Name="BackdropImage"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Stretch="UniformToFill"
               Opacity="0.42"
               IsHitTestVisible="False" />

        <Grid IsHitTestVisible="False">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E60B0B0F" Offset="0.0" />
                    <GradientStop Color="#A60B0B0F" Offset="0.34" />
                    <GradientStop Color="#F20B0B0F" Offset="0.70" />
                    <GradientStop Color="#FF0B0B0F" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>

        <ScrollViewer HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      Padding="72 56 72 96">
            <StackPanel Spacing="48">
                <!-- Hero: poster first, then the decision path. -->
                <Grid MinHeight="520" ColumnSpacing="52">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="300"
                            Height="450"
                            CornerRadius="16"
                            Background="{StaticResource SurfaceTertiaryBrush}"
                            VerticalAlignment="Center">
                        <Image x:Name="PosterImage"
                               Stretch="UniformToFill"
                               IsHitTestVisible="False" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                MaxWidth="1120"
                                Spacing="22">
                        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                   FontSize="56"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxLines="2" />

                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                                       FontSize="18"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.CommunityRating, Mode=OneWay}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningBrush}"
                                       Visibility="{x:Bind ViewModel.CommunityRating, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                            <TextBlock Text="{x:Bind ViewModel.Runtime, Mode=OneWay}"
                                       FontSize="18"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Visibility="{x:Bind ViewModel.Runtime, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                            <Border Padding="10 5"
                                    CornerRadius="6"
                                    Background="{StaticResource SurfaceTertiaryBrush}"
                                    Visibility="{x:Bind ViewModel.OfficialRating, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                                <TextBlock Text="{x:Bind ViewModel.OfficialRating, Mode=OneWay}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>

                        <ScrollViewer HorizontalScrollMode="Enabled"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Genres, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12 7"
                                                CornerRadius="7"
                                                Background="{StaticResource SurfaceTertiaryBrush}">
                                            <TextBlock Text="{Binding}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                                   FontSize="18"
                                   LineHeight="30"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="1000"
                                   Visibility="{x:Bind ViewModel.Description, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button AutomationProperties.Name="Play"
                                    Command="{x:Bind ViewModel.PlayItemCommand}"
                                    CommandParameter="{x:Bind ViewModel.Item, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="28 16"
                                    CornerRadius="10"
                                    MinWidth="170">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE768;" FontSize="18" />
                                    <TextBlock Text="{x:Bind ViewModel.ResumeLabel, Mode=OneWay}"
                                               FontSize="17"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button AutomationProperties.Name="Favorite"
                                    Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    CornerRadius="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE734;" FontSize="17" />
                                    <TextBlock Text="{x:Bind ViewModel.FavoriteLabel, Mode=OneWay}"
                                               FontSize="16" />
                                </StackPanel>
                            </Button>

                            <Button AutomationProperties.Name="Trailer"
                                    Command="{x:Bind ViewModel.PlayTrailerCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    CornerRadius="10"
                                    Visibility="{x:Bind ViewModel.HasTrailer, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="17" />
                                    <TextBlock Text="Trailer" FontSize="16" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Padding="14 12"
                                CornerRadius="8"
                                Background="{StaticResource SurfaceSecondaryBrush}"
                                Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Series content -->
                <StackPanel Visibility="{x:Bind ViewModel.IsSeries, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Spacing="18">
                    <TextBlock Text="Episodes"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <ListView ItemsSource="{x:Bind ViewModel.Seasons, Mode=OneWay}"
                              SelectedIndex="{x:Bind ViewModel.SelectedSeasonIndex, Mode=TwoWay}"
                              SelectionMode="Single"
                              Background="Transparent"
                              Height="66"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                              ScrollViewer.HorizontalScrollMode="Enabled"
                              ScrollViewer.VerticalScrollMode="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="22 13"
                                        CornerRadius="9"
                                        Background="{StaticResource SurfaceTertiaryBrush}">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="16"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ListView ItemsSource="{x:Bind ViewModel.Episodes, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              Background="Transparent"
                              ItemClick="Episode_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0 0 0 10"
                                        Padding="16"
                                        CornerRadius="12"
                                        Background="{StaticResource SurfaceSecondaryBrush}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding IndexNumber}"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" />

                                        <Border Grid.Column="1"
                                                Width="180"
                                                Height="102"
                                                CornerRadius="8"
                                                Background="{StaticResource SurfaceTertiaryBrush}">
                                            <Image Source="{Binding Converter={StaticResource ItemImageConverter}, ConverterParameter=Primary}"
                                                   Stretch="UniformToFill" />
                                        </Border>

                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Spacing="5">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="2" />
                                            <TextBlock Text="{Binding Overview}"
                                                       FontSize="14"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="2"
                                                       Opacity="0.9" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding RunTimeTicks, Converter={StaticResource TicksToTimeSpanConverter}}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- Cast -->
                <StackPanel Visibility="{x:Bind ViewModel.HasCast, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Spacing="18">
                    <TextBlock Text="Cast"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Cast, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="22" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="112" Spacing="9">
                                        <Border Width="82"
                                                Height="82"
                                                CornerRadius="41"
                                                Background="{StaticResource SurfaceTertiaryBrush}"
                                                HorizontalAlignment="Center">
                                            <Grid>
                                                <FontIcon Glyph="&#xE77B;"
                                                          FontSize="30"
                                                          Foreground="{StaticResource TextMutedBrush}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                                <Border CornerRadius="41">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Converter={StaticResource PersonImageConverter}}"
                                                                    Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"
                                                   TextAlignment="Center" />
                                        <TextBlock Text="{Binding Role}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"
                                                   TextAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Similar titles -->
                <StackPanel Visibility="{x:Bind ViewModel.HasSimilarItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Spacing="18">
                    <TextBlock Text="More Like This"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SimilarItems, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="18" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button AutomationProperties.Name="Open similar title"
                                            Background="Transparent"
                                            Padding="0"
                                            BorderThickness="0"
                                            Click="SimilarItem_Click"
                                            CornerRadius="10">
                                        <StackPanel Width="170" Spacing="9">
                                            <Border Width="170"
                                                    Height="255"
                                                    CornerRadius="10"
                                                    Background="{StaticResource SurfaceTertiaryBrush}">
                                                <Image Source="{Binding Converter={StaticResource ItemImageConverter}, ConverterParameter=Primary}"
                                                       Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="2" />
                                            <TextBlock Text="{Binding ProductionYear}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Persistent, high-contrast navigation affordance. -->
        <Button x:Name="BackButton"
                AutomationProperties.Name="Back"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="28 24"
                Width="56"
                Height="56"
                Padding="0"
                CornerRadius="12"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="Back_Click">
            <FontIcon Glyph="&#xE72B;" FontSize="20" />
        </Button>

        <Grid Background="#CC0B0B0F"
              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Width="54"
                              Height="54" />
                <TextBlock Text="Loading details…"
                           FontSize="18"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="560"
                Padding="30"
                CornerRadius="14"
                Background="{StaticResource SurfaceSecondaryBrush}"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Spacing="16">
                <TextBlock Text="Couldn’t open this title"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           FontSize="16"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
                <Button Content="Try again"
                        Command="{x:Bind ViewModel.RetryCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Left"
                        Padding="24 13"
                        CornerRadius="9" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
