<Page
    x:Class="JellyfinXbox.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JellyfinXbox.Views">

    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollMode="Disabled"
                  VerticalSnapPointsType="None">
        <Grid>
        <StackPanel Padding="64 48 64 72" Spacing="52">

            <!-- ═══════════════════════════════════════ -->
            <!--          WELCOME HEADER                 -->
            <!-- ═══════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock Text="Good evening"
                               FontSize="36" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="What do you want to watch?"
                               FontSize="18"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <!-- User avatar -->
                <Border Grid.Column="1" Width="48" Height="48" CornerRadius="24"
                        Background="{StaticResource SurfaceTertiaryBrush}">
                    <FontIcon Glyph="&#xE77B;" FontSize="24"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════ -->
            <!--               MY MEDIA                  -->
            <!-- ═══════════════════════════════════════ -->
            <StackPanel Visibility="{x:Bind ViewModel.Libraries.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}"
                        Spacing="16">
                <TextBlock Text="My Media"
                           FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Disabled">
                    <GridView ItemsSource="{x:Bind ViewModel.Libraries, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="LibraryItem_Click">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="16" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="200" Height="90"
                                      CornerRadius="12"
                                      Background="{StaticResource SurfaceSecondaryBrush}"
                                      BorderBrush="{StaticResource SurfaceTertiaryBrush}"
                                      BorderThickness="1"
                                      Padding="18 14">
                                    <StackPanel VerticalAlignment="Center" Spacing="6">
                                        <FontIcon Glyph="&#xE8B9;" FontSize="20"
                                                  Foreground="{StaticResource PrimaryBrush}"
                                                  HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </ScrollViewer>
            </StackPanel>

            <!-- ═══════════════════════════════════════ -->
            <!--          CONTINUE WATCHING               -->
            <!-- ═══════════════════════════════════════ -->
            <StackPanel Visibility="{x:Bind ViewModel.HasContinueWatching, Mode=OneWay}"
                        Spacing="20">
                <TextBlock Text="Continue Watching"
                           FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Disabled">
                    <GridView ItemsSource="{x:Bind ViewModel.ContinueWatching}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="MediaItem_Click">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="320" Height="180"
                                      CornerRadius="12"
                                      Background="{StaticResource SurfaceTertiaryBrush}">
                                    <!-- Poster -->
                                    <Border CornerRadius="12">
                                        <Image Source="{Binding Converter={StaticResource ItemImageConverter}, ConverterParameter=Backdrop}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <!-- Progress bar -->
                                    <StackPanel VerticalAlignment="Bottom"
                                                Background="{StaticResource SurfaceSecondaryBrush}"
                                                Padding="12 8" Spacing="4">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Value="{Binding UserData.PlayedPercentage}"
                                                     Maximum="100"
                                                     Visibility="{Binding UserData.PlayedPercentage, Converter={StaticResource NullToVisibilityConverter}}"
                                                     Foreground="{StaticResource AccentBrush}"
                                                     Background="{StaticResource SurfaceHoverBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </ScrollViewer>
            </StackPanel>

            <!-- ═══════════════════════════════════════ -->
            <!--              NEXT UP                     -->
            <!-- ═══════════════════════════════════════ -->
            <StackPanel Visibility="{x:Bind ViewModel.HasNextUp, Mode=OneWay}"
                        Spacing="20">
                <TextBlock Text="Next Up"
                           FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Disabled">
                    <GridView ItemsSource="{x:Bind ViewModel.NextUp}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="MediaItem_Click">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="320" Height="180"
                                      CornerRadius="12"
                                      Background="{StaticResource SurfaceTertiaryBrush}">
                                    <Border CornerRadius="12">
                                        <Image Source="{Binding Converter={StaticResource ItemImageConverter}, ConverterParameter=Backdrop}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Bottom"
                                                Background="{StaticResource SurfaceSecondaryBrush}"
                                                Padding="12 8" Spacing="2">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SeriesName}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </ScrollViewer>
            </StackPanel>

            <!-- ═══════════════════════════════════════ -->
            <!--           LATEST MOVIES                  -->
            <!-- ═══════════════════════════════════════ -->
            <StackPanel Visibility="{x:Bind ViewModel.LatestMovies.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}"
                        Spacing="20">
                <TextBlock Text="Latest Movies"
                           FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Disabled">
                    <GridView ItemsSource="{x:Bind ViewModel.LatestMovies}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="MediaItem_Click">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="160" Spacing="8">
                                    <Border Width="160" Height="240"
                                            CornerRadius="12"
                                            Background="{StaticResource SurfaceTertiaryBrush}">
                                        <Image Source="{Binding Converter={StaticResource ItemImageConverter}, ConverterParameter=Primary}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13" FontWeight="Medium"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="2" />
                                    <TextBlock Text="{Binding ProductionYear}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </ScrollViewer>
            </StackPanel>

            <!-- ═══════════════════════════════════════ -->
            <!--          LATEST SHOWS                    -->
            <!-- ═══════════════════════════════════════ -->
            <StackPanel Visibility="{x:Bind ViewModel.LatestShows.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}"
                        Spacing="20">
                <TextBlock Text="Latest Shows"
                           FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Disabled">
                    <GridView ItemsSource="{x:Bind ViewModel.LatestShows}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="MediaItem_Click">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="160" Spacing="8">
                                    <Border Width="160" Height="240"
                                            CornerRadius="12"
                                            Background="{StaticResource SurfaceTertiaryBrush}">
                                        <Image Source="{Binding Converter={StaticResource ItemImageConverter}, ConverterParameter=Primary}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13" FontWeight="Medium"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="2" />
                                    <TextBlock Text="{Binding ProductionYear}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </ScrollViewer>
            </StackPanel>

        </StackPanel>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="44" Height="44" />
            <TextBlock Text="Loading your library…" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Padding="24"
                Background="{StaticResource SurfaceSecondaryBrush}"
                Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
            <StackPanel Spacing="12"><TextBlock Text="Couldn’t load Home" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" />
                <Button Content="Retry" Command="{x:Bind ViewModel.RetryCommand}" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>
        </Grid>
    </ScrollViewer>
</Page>
