<Page
    x:Class="JellyfinXbox.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource SurfacePrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Padding="56 40 56 0" Spacing="24">
            <StackPanel Orientation="Horizontal" Spacing="20">
                 <Button AutomationProperties.Name="Back" Background="{StaticResource GlassSurfaceBrush}"
                        BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Padding="12" CornerRadius="14" Click="Back_Click">
                    <FontIcon Glyph="&#xE72B;" FontSize="18" />
                </Button>
                 <TextBlock Text="{x:Bind ViewModel.LibraryName, Mode=OneWay}"
                            FontSize="34" FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            VerticalAlignment="Center" />
            </StackPanel>

            <!-- Filter chips -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                 <RadioButton Content="All" GroupName="Filter" IsChecked="True"
                              Style="{StaticResource PillRadioButtonStyle}"
                              Click="FilterAll_Click"
                              FontSize="14" />
                 <RadioButton Content="Unwatched" GroupName="Filter"
                              Style="{StaticResource PillRadioButtonStyle}"
                              Click="FilterUnwatched_Click"
                              FontSize="14" />
                 <RadioButton Content="Favorites" GroupName="Filter"
                              Style="{StaticResource PillRadioButtonStyle}"
                              Click="FilterFavorites_Click"
                              FontSize="14" />
                 <RadioButton Content="Collections" GroupName="Filter"
                              Style="{StaticResource PillRadioButtonStyle}"
                              Click="FilterCollections_Click"
                              FontSize="14" />
                 <RadioButton Content="Playlists" GroupName="Filter"
                              Style="{StaticResource PillRadioButtonStyle}"
                              Click="FilterPlaylists_Click"
                              FontSize="14" />
            </StackPanel>
        </StackPanel>

        <!-- Items grid -->
        <ScrollViewer Grid.Row="1" Padding="56 32 56 64">
            <StackPanel Spacing="16">
            <GridView x:Name="ItemsGrid"
                      ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="Item_Click">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal"
                                       MaximumRowsOrColumns="6"
                                       ItemWidth="180" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="160" Spacing="8">
                            <Border Width="160" Height="240"
                                    CornerRadius="16"
                                    Background="{StaticResource SurfaceTertiaryBrush}">
                                <Image Source="{Binding Converter={StaticResource ItemImageConverter}, ConverterParameter=Primary}"
                                       Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{Binding Name}"
                                       FontSize="13" FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="2" />
                            <TextBlock Text="{Binding ProductionYear}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <Button Content="Load more" Command="{x:Bind ViewModel.LoadMoreCommand}"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.HasMore, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="44" Height="44"
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" MaxWidth="520"
                       Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
            <Button Content="Retry" Command="{x:Bind ViewModel.RetryCommand}"
                    Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
            <TextBlock Text="Nothing here yet" Foreground="{StaticResource TextSecondaryBrush}"
                       Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>
    </Grid>
</Page>
