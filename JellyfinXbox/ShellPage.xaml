<Page
    x:Class="JellyfinXbox.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JellyfinXbox"
    xmlns:views="using:JellyfinXbox.Views"
    NavigationCacheMode="Required">

    <Grid Background="{StaticResource SurfacePrimaryBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════ -->
        <!--             SIDE NAV BAR                 -->
        <!-- ═══════════════════════════════════════ -->
        <Border x:Name="SideNavRail" Grid.Column="0" Width="92"
                Margin="24 24 0 24"
                Padding="8 12"
                Background="{StaticResource GlassAcrylicBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="28"
                VerticalAlignment="Stretch">
            <Grid VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top nav items -->
                <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="18"
                            Padding="0 28">
                    <!-- Logo -->
                    <Border Width="54" Height="54" CornerRadius="18"
                            HorizontalAlignment="Center"
                            Background="{StaticResource SurfacePrimaryBrush}"
                            BorderBrush="{StaticResource GlassBorderBrush}"
                            BorderThickness="1"
                            Margin="0 0 0 18">
                        <Image Source="Assets/Logo.png" Width="42" Height="42" Stretch="Uniform" />
                    </Border>

                    <!-- Home -->
                    <RadioButton x:Name="NavHome"
                                 Tag="home"
                                 Style="{StaticResource NavRadioButtonStyle}"
                                 AutomationProperties.Name="Home"
                                 Click="NavButton_Click">
                        <FontIcon Glyph="&#xE80F;" FontSize="24" />
                    </RadioButton>

                    <!-- Search -->
                    <RadioButton x:Name="NavSearch"
                                 Tag="search"
                                 Style="{StaticResource NavRadioButtonStyle}"
                                 AutomationProperties.Name="Search"
                                 Click="NavButton_Click">
                        <FontIcon Glyph="&#xE721;" FontSize="24" />
                    </RadioButton>
                    <RadioButton x:Name="NavCollections" Tag="collections" Style="{StaticResource NavRadioButtonStyle}" AutomationProperties.Name="Collections" Click="NavButton_Click">
                        <FontIcon Glyph="&#xE8A4;" FontSize="24" />
                    </RadioButton>
                    <RadioButton x:Name="NavPlaylists" Tag="playlists" Style="{StaticResource NavRadioButtonStyle}" AutomationProperties.Name="Playlists" Click="NavButton_Click">
                        <FontIcon Glyph="&#xE8A5;" FontSize="24" />
                    </RadioButton>
                    <RadioButton x:Name="NavFavorites" Tag="favorites" Style="{StaticResource NavRadioButtonStyle}" AutomationProperties.Name="Favorites" Click="NavButton_Click">
                        <FontIcon Glyph="&#xE734;" FontSize="24" />
                    </RadioButton>
                </StackPanel>

                <!-- Bottom nav items -->
                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Spacing="18"
                            Padding="0 0 0 28">
                    <!-- Quick Connect -->
                    <RadioButton x:Name="NavQuickConnect"
                                 Tag="quickconnect"
                                 Style="{StaticResource NavRadioButtonStyle}"
                                 AutomationProperties.Name="Quick Connect"
                                 Click="NavButton_Click">
                        <FontIcon Glyph="&#xE8BD;" FontSize="24" />
                    </RadioButton>

                    <!-- Settings -->
                    <RadioButton x:Name="NavSettings"
                                 Tag="settings"
                                 Style="{StaticResource NavRadioButtonStyle}"
                                 AutomationProperties.Name="Settings"
                                 Click="NavButton_Click">
                        <FontIcon Glyph="&#xE713;" FontSize="24" />
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════ -->
        <!--              CONTENT AREA                -->
        <!-- ═══════════════════════════════════════ -->
        <Frame x:Name="ContentFrame"
               Grid.Column="1"
               HorizontalContentAlignment="Stretch"
               VerticalContentAlignment="Stretch"
               Navigated="ContentFrame_Navigated" />
    </Grid>
</Page>
